* text=auto

# Linux 上直接执行 / 被 ini 解析的文件必须是 LF，否则报 bad interpreter 或解析失败
*.sh      text eol=lf
*.py      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.ini     text eol=lf

# Windows 批处理必须 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
